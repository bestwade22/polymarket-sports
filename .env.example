# --- Polymarket trading credentials ---------------------------------------
# EOA private key (0x...) used to sign CLOB orders.
PRIVATE_KEY=
# Polymarket proxy wallet address (profile address) when SIGNATURE_TYPE=1.
DEPOSIT_WALLET_ADDRESS=
# 0 = EOA, 1 = Polymarket proxy (email/Magic), 2 = Gnosis Safe, 3 = POLY_1271.
SIGNATURE_TYPE=1

# --- External APIs ----------------------------------------------------------
# API Ninjas key for NBA schedule + standings.
API_NINJAS_KEY=

# --- Notifications ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_ENABLED=true

# --- AWS --------------------------------------------------------------------
AWS_REGION=ap-east-1
DYNAMODB_TABLE=SportsBotState
SQS_QUEUE_URL=

# --- Local dev stack (moto) -------------------------------------------------
# Left empty in AWS. scripts/local_stack.sh prints the values to paste.
DYNAMODB_ENDPOINT_URL=
SQS_ENDPOINT_URL=

# --- Strategy knobs ---------------------------------------------------------
# Shares to buy when the trigger fires.
SHARE_COUNT=5
# Trigger when the monitored team's live bid <= ratio * pre-game mid price.
PRICE_DROP_RATIO=0.5
# Take the pre-game snapshot this many minutes before tip-off.
PRE_GAME_SNAPSHOT_MINUTES=30
# Stop monitoring after this NBA period (2 = halftime).
MONITOR_STOP_AFTER_PERIOD=2
# Hard cap on minutes after tip-off.
MONITOR_MAX_MINUTES=150
# The buy order is GTD, expiring this many minutes after placement.
BUY_ORDER_EXPIRY_MINUTES=5
# 0 = GTC for the recovery sell.
SELL_ORDER_EXPIRY_HOURS=0
# Optional: also require the opponent's price to have risen.
REQUIRE_OPPONENT_RISE=false
# Absolute price bounds for the monitored team at trigger time.
TRIGGER_MIN_PRICE=0.01
TRIGGER_MAX_PRICE=0.99

# --- Behaviour --------------------------------------------------------------
# true = never place a real order. Keep this true until paper trading validates.
DRY_RUN=true
SPORTS_LEAGUE=nba
POLYMARKET_SERIES_ID=10345
SNAPSHOT_INTERVAL_MINUTES=5
TTL_DAYS=3

# --- Listener window -------------------------------------------------------
# How long before the first tip-off the Fargate listener must be running.
# Must cover PRE_GAME_SNAPSHOT_MINUTES plus SNAPSHOT_INTERVAL_MINUTES.
LISTENER_LEAD_MINUTES=40
# How long after the last tip-off the listener stays running, to cover the
# halftime cutoff and any in-flight buy's recovery sell.
LISTENER_TRAIL_MINUTES=90

# --- WebSocket tuning -------------------------------------------------------
WS_PING_INTERVAL=10
WS_RECONNECT_MAX_SECONDS=30
WS_IDLE_TIMEOUT_SECONDS=300
WS_USER_ENABLED=true

# --- Scheduling -------------------------------------------------------------
DAILY_FETCH_HOUR_UTC=0
DAILY_FETCH_MINUTE_UTC=30
